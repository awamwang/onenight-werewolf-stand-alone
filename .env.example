# 复制为 .env.development / .env.production 后按环境修改

# 公共路径（子路径静态部署须以 / 开头和结尾，如 /werewolf/）
VITE_BASE=/

VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5174

VITE_PREVIEW_HOST=127.0.0.1
VITE_PREVIEW_PORT=5006

# 大厅地址：有值时首页显示「返回大厅」
# 本地：http://localhost:5000/
# 生产同域：/game-lobby/
VITE_LOBBY_URL=

VITE_PWA_ENABLED=true
